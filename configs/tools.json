    {
      "id": "dev_browser_snapshot",
      "label": "dev-browser",
      "categories": [
        "browser_automation"
      ],
      "requires_executables": [
        "dev-browser"
      ],
      "network": true,
      "command": [
        "dev-browser",
        "--headless",
        "--timeout",
        "{timeout_seconds}",
        "run",
        "{script_path}"
      ],
      "script_template": "const page = await browser.getPage('bench-{case_id}');\nawait page.goto({url!r}, {{ waitUntil: 'domcontentloaded', timeout: {timeout_seconds}000 }});\nawait page.locator({search_selector!r}).first().fill({search_value!r}, {{ timeout: 8000 }});\nif ({submit_selector!r}) {{\n  await page.locator({submit_selector!r}).first().click({{ timeout: 8000 }});\n}} else {{\n  await page.locator({search_selector!r}).first().press('Enter');\n}}\nawait page.waitForTimeout(2500);\nif ({result_selector!r}) {{\n  await page.locator({result_selector!r}).first().click({{ timeout: 10000 }}).catch(() => null);\n  await page.waitForTimeout(2500);\n}}\nif ({follow_selector!r}) {{\n  await page.locator({follow_selector!r}).first().click({{ timeout: 10000 }}).catch(() => null);\n  await page.waitForTimeout(2500);\n}}\nconst text = await page.locator('body').innerText({{ timeout: 8000 }});\nconst links = await page.locator('a').evaluateAll(els => els.slice(0, 80).map(a => ({{ text: a.innerText, href: a.href }})));\nconsole.error('task: ' + {prompt!r});\nconsole.log(JSON.stringify({{ url: page.url(), title: await page.title(), text: text.slice(0, 18000), links }}, null, 2));"
    },
