    {
      "id": "dev_browser_snapshot",
      "label": "dev-browser",
      "categories": [
        "browser_automation"
      ],
      "requires_executables": [
        "dev-browser"
      ],
      "network": true,
      "command": [
        "dev-browser",
        "--headless",
        "--timeout",
        "{timeout_seconds}",
        "run",
        "{script_path}"
      ],
      "script_template": "const page = await browser.getPage('bench-{case_id}');\nawait page.goto({url!r}, {{ waitUntil: 'domcontentloaded', timeout: {timeout_seconds}000 }});\nawait page.locator({search_selector!r}).first().fill({search_value!r}, {{ timeout: 8000 }});\nif ({submit_selector!r}) {{\n  await page.locator({submit_selector!r}).first().click({{ timeout: 8000 }});\n}} else {{\n  await page.locator({search_selector!r}).first().press('Enter');\n}}\nawait page.waitForTimeout(2500);\nif ({result_selector!r}) {{\n  await page.locator({result_selector!r}).first().click({{ timeout: 10000 }}).catch(() => null);\n  await page.waitForTimeout(2500);\n}}\nif ({follow_selector!r}) {{\n  await page.locator({follow_selector!r}).first().click({{ timeout: 10000 }}).catch(() => null);\n  await page.waitForTimeout(2500);\n}}\nconst text = await page.locator('body').innerText({{ timeout: 8000 }});\nconst links = await page.locator('a').evaluateAll(els => els.slice(0, 80).map(a => ({{ text: a.innerText, href: a.href }})));\nconsole.log(JSON.stringify({{ url: page.url(), title: await page.title(), task: {prompt!r}, text: text.slice(0, 18000), links }}, null, 2));"
    },
    {
      "id": "playwright_browser_task",
      "label": "Playwright script",
      "categories": [
        "browser_automation"
      ],
      "requires_executables": [
        "uvx"
      ],
      "network": true,
      "command": [
        "uvx",
        "--from",
        "playwright",
        "python",
        "scripts/adapters/playwright_browser_task.py",
        "{url}",
        "{timeout_seconds}",
        "{search_selector}",
        "{search_value}",
        "{submit_selector}",
        "{result_selector}",
        "{follow_selector}",
        "{prompt}"
      ]
    },
    {
      "id": "browser_harness",
      "label": "browser-harness",
      "categories": [
        "browser_automation"
      ],
      "requires_executables": [
        "browser-harness"
      ],
      "network": true,
      "command": [
        "browser-harness"
      ],
      "stdin_template": "import json\nnew_tab({url!r})\nwait_for_load(20)\nscript = r'''\n(async () => {{\n  const sleep = ms => new Promise(r => setTimeout(r, ms));\n  const pick = sel => sel ? document.querySelector(sel) : null;\n  const input = pick({search_selector!r});\n  if (!input) return {{ error: 'missing search input', url: location.href, title: document.title, text: document.body ? document.body.innerText.slice(0, 18000) : '' }};\n  input.focus();\n  input.value = {search_value!r};\n  input.dispatchEvent(new Event('input', {{ bubbles: true }}));\n  input.dispatchEvent(new Event('change', {{ bubbles: true }}));\n  const submit = pick({submit_selector!r});\n  if (submit) submit.click();\n  else if (input.form && input.form.requestSubmit) input.form.requestSubmit();\n  else input.dispatchEvent(new KeyboardEvent('keydown', {{ key: 'Enter', code: 'Enter', bubbles: true }}));\n  await sleep(2500);\n  const result = pick({result_selector!r});\n  if (result) {{ result.click(); await sleep(2500); }}\n  const follow = pick({follow_selector!r});\n  if (follow) {{ follow.click(); await sleep(2500); }}\n  const links = Array.from(document.querySelectorAll('a')).slice(0, 80).map(a => ({{ text: a.innerText, href: a.href }}));\n  return {{ url: location.href, title: document.title, task: {prompt!r}, text: document.body ? document.body.innerText.slice(0, 18000) : '', links }};\n}})()\n'''\nresult = js(script) or {{}}\nprint(json.dumps(result, indent=2))\n"
    },
